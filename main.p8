-- THIS LINE OF CODE IS RESPONSIBLE FOR PLAYING THE MUSIC IN THE GAME
-- Music is the arrangement of sound to create some combination of
-- form, harmony, melody, rhythm, or otherwise expressive
-- content.[1][2][3] Music is generally agreed to be a cultural
-- universal that is present in all human societies.[4] Definitions
-- of music vary widely in substance and approach.[5] While scholars
-- agree that music is defined by a small number of specific elements,
-- there is no consensus as to what these necessary elements are.[6]
-- Music is often characterized as a highly versatile medium for
-- expressing human creativity.[7] Diverse activities are involved in
-- the creation of music, and are often divided into categories of
-- composition, improvisation, and performance.[8] Music may be
-- performed using a wide variety of musical instruments, including
-- the human voice. It can also be composed, sequenced, or otherwise
-- produced to be indirectly played mechanically or electronically,
-- such as via a music box, barrel organ, or digital audio workstation
-- software on a computer.
-- music(0)

-- TILE STUFF
tile_t = {0, 1, 2, 3, 4, 7, 12, 17, 22}
tile_o = {1, 2, 3, 6, 8, 11, 13, 16, 18, 21, 22, 23}
tile_e = {1, 2, 3, 6, 11, 12, 16, 21, 22, 23}
tile_s = {1, 2, 3, 6, 11, 12, 13, 18, 21, 22, 23}
tile_m = {0, 1, 3, 4, 5, 7, 9, 10, 12, 14, 15, 17, 19, 20, 24}

tile_9 = {0, 1, 2, 3, 4, 5, 9, 10, 11, 12, 13, 14, 19, 20, 21, 22, 23, 24}
tile_8 = {0, 1, 2, 3, 4, 5, 9, 10, 11, 12, 13, 14, 15, 19, 20, 21, 22, 23, 24}
tile_7 = {0, 1, 2, 3, 4, 9, 14, 19, 24}
tile_6 = {0, 1, 2, 3, 4, 5, 10, 11, 12, 13, 14, 15, 19, 20, 21, 22, 23, 24}
tile_5 = {0, 1, 2, 3, 4, 5, 10, 11, 12, 13, 14, 19, 20, 21, 22, 23, 24}
tile_4 = {0, 4, 5, 9, 10, 11, 12, 13, 14, 19, 24}
tile_3 = {0, 1, 2, 3, 4, 9, 10, 11, 12, 13, 14, 19, 20, 21, 22, 23, 24}
tile_2 = {0, 1, 2, 3, 4, 9, 10, 11, 12, 13, 14, 15, 20, 21, 22, 23, 24}
tile_1 = {2, 6, 7, 12, 17, 22}
tile_0 = {0, 1, 2, 3, 4, 5, 9, 10, 14, 15, 19, 20, 21, 22, 23, 24}

-- tile_list_1 = {tile_9, tile_8, tile_7, tile_6, tile_5, tile_4, tile_3, tile_2, tile_1, tile_0}
tile_list_1 = {tile_9, tile_8, tile_7, tile_6, tile_5}
tile_list_2 = {tile_4, tile_3, tile_2, tile_1, tile_0}
tile_list_3 = {tile_t, tile_o, tile_e, tile_s, tile_m}

-- tile_lists = {tile_list_1, tile_list_2, tile_list_3}
tile_lists = {tile_list_1}

current_tile_list = 1
current_tile = 1

fade = 0

patterns = {
    0x0000, -- 0%
    0x8000, -- 6%
    0x8080, -- 12%
    0xa0a0, -- 25%
    0xa5a5, -- 50%
    0xf5f5, -- 75%
    0xf7f7, -- 87%
    0xffff  -- 100%
}

game_speed = 1

dead_time = 120

-- SCREEN STUFF
screen_size = 128
bart_size = 8
marge_size = 7

-- PLAYER STUFF
bart_movement_speed = 3
max_health = 140
bart_health = max_health
active_player_sprite = 1

-- STATE STUFF
state = "flashing"
screen_state = "menu"
show_warning = false
warning_count = 0

-- PARTICLE STUFF
particles = {}

-- HOMER STUFF
spawn_homer_every_number_of_these_tiles = 3
homer_eating_damage = 5
evil_homers = {}

-- MAGGIE STUFF
spawn_maggie_every_number_of_these_tiles = 4
maggie_gave_you_a_gun = false
bullets = {}
maggie_is_on_screen = false
maggie_pos = {x = 0, y = 0}

-- LISA STUFF
spawn_lisa_every_number_of_these_tiles = 5
lisa_is_on_screen = false
lisa_pos = {x = 0, y = 0}

function reset_game()
    state = "flashing"
    show_warning = false
    show_safe = false
    warning_count = 0
    death_particle_life = 0
    death_particles = {}
    maggie_gave_you_a_gun = false
    maggie_is_on_screen = false
    lisa_is_on_screen = false
    bullets = {}
    evil_homers = {}
    current_tile = 1
    fade = 0
    bart_health = 140
    timer_val = flash_time
    active_player_sprite = 1
    current_tile_list = 1
    game_speed = 1

end

function make_homer(x, y)
    return {
        x = x,
        y = y,
        sp = 2,

        update = function(self)
            local dx = pos_x - self.x
            local dy = pos_y - self.y
            local dist = sqrt(dx*dx + dy*dy)

            if dist > 0 then
                self.x += dx / dist * self.sp
                self.y += dy / dist * self.sp
            end
        end,

        draw = function(self)
            spr(7, self.x, self.y)
        end
    }
end

function make_bullet(target_x, target_y)
    local dx = target_x - pos_x
    local dy = target_y - pos_y
    local dist = sqrt(dx*dx + dy*dy)
    local x_dir = dx/dist
    local y_dir = dy/dist

    return {
        x = pos_x,
        y = pos_y,
        x_dir = x_dir,
        y_dir = y_dir,
        sp = 5,
        life = 60,

        update = function(self)
            self.life -= 1
            self.x += x_dir*self.sp
            self.y += y_dir*self.sp
        end,

        draw = function(self)
            spr(19, self.x, self.y)
        end
    }
end

function _init()
    pos_x = 64
    pos_y = 64
    timer_val = 10

    tile_list = tile_list_1
end

function _update()
    if screen_state == "menu" then
        if btnp(🅾️) then
            screen_state = "game"
            music(0)
        end
    elseif screen_state == "win" then
        music(-1)
        if btnp(🅾️) then
            screen_state = "menu"
        end
    elseif screen_state == "game" then

        -- 10 frames = 0.33 seconds
        flash_time = 10/game_speed

        -- Should be 90 frames but 1 
        safe_time = 90/game_speed

        tile_list = tile_lists[current_tile_list]
        --------------------- BART MOVEMENT ---------------------
        if state ~= "dead" then
            new_pos_x = pos_x
            new_pos_y = pos_y
            
            if btn(➡️) then
                new_pos_x = min(pos_x + bart_movement_speed, screen_size - bart_size - marge_size)
            end

            if btn(⬅️) then
                new_pos_x = max(pos_x - bart_movement_speed, 0)
            end
            if btn(⬇️) then
                new_pos_y = min(pos_y + bart_movement_speed, screen_size - bart_size - marge_size)
            end
            if btn(⬆️) then
                new_pos_y = max(pos_y - bart_movement_speed, 0)
            end

            if btnp(❎) and maggie_gave_you_a_gun then
                shoot()
            end

            if not(state == "safe" and not check_safety(new_pos_x, new_pos_y, bart_size)) then
                pos_x = new_pos_x
                pos_y = new_pos_y
            end
        end
        ---------------------------------------------------------

        --------------------- STATE MACHINE  --------------------
        next_state = state

        if state == "flashing" then
            
            timer_val -= 1

            if timer_val <= 0 then
                timer_val = flash_time

                warning_count += 1
                show_flashing = not show_flashing

                -- Transition to safe
                if warning_count >= 7 then
                    next_state = "safe"
                    warning_count = 0
                    timer_val = safe_time
                    show_flashing = false
                else
                    if show_flashing then
                        sfx(3)
                        sfx(4)
                    end
                end
            end
        elseif state == "safe" then
            timer_val -= 1

            if not check_safety(pos_x, pos_y, bart_size) then
                kill_bart()
                timer_val = dead_time
                next_state = "dead"
            end

            if not show_safe then sfx(5) end
            
            show_safe = true

            -- Transition to flashing
            if timer_val <= 1 then
                if current_tile < # tile_list then
                    timer_val = flash_time
                    current_tile += 1
                else
                    level_up()
                end
                next_state = "flashing"
                show_safe = false
            end
        
        elseif state == "dead" then
            timer_val -= 1

            active_player_sprite = 17

            if timer_val <= 0 then
                next_state = "end"
            end

        elseif state == "end" then
            fade += 0.5

            if fade == 8 then
                next_state = "flashing"
                screen_state = "menu"
                reset_game()
            end
        end

        move_particles()
        ---------------------------------------------------------

        --------------------- HOMER UPDATES ---------------------
        at_least_one_homer_is_eating = false
        for h in all(evil_homers) do
            h:update()

            if state ~= "dead" and state ~= "end" do
                if homer_hit_bart(h) then
                    at_least_one_homer_is_eating = true
                end
            end
        end

        if at_least_one_homer_is_eating then
            add_munching_particle()
            bart_health -= homer_eating_damage
            sfx(1)
        end

        if state ~= "dead" and state ~= "end" do
            if bart_health == 0 then
                kill_bart()
                timer_val = dead_time
                next_state = "dead"
            end
        end

        if current_tile % spawn_homer_every_number_of_these_tiles == 0 and prev_tile ~= current_tile then
            add(evil_homers, make_homer(rnd(128), rnd(128)))
        end

        if not maggie_is_on_screen and current_tile % spawn_maggie_every_number_of_these_tiles == 0 and prev_tile ~= current_tile then
            maggie_is_on_screen = true
            maggie_pos = {x = rnd(110), y = rnd(110)}
        end

        if not lisa_is_on_screen and current_tile % spawn_lisa_every_number_of_these_tiles == 0 and prev_tile ~= current_tile then
            lisa_is_on_screen = true
            lisa_pos = {x = rnd(110), y = rnd(110)}
        end
        ---------------------------------------------------------

        for b in all(bullets) do
            if b.life == 0 then
                del(bullets, b)
            else
                b:update()
                for h in all(evil_homers) do
                    if bullet_hit_homer(h, b) then
                        spawn_homer_death_particles(h.x, h.y)
                        del(bullets, b)
                        del(evil_homers, h)
                        
                        sfx(12)
                    end
                end
            end
        end


        if maggie_is_on_screen and collide_with_maggie() then
            maggie_is_on_screen = false
            maggie_gave_you_a_gun = true
            sfx(14)
        end

        if lisa_is_on_screen and collide_with_lisa() then
            lisa_is_on_screen = false
            bart_health = min(max_health, 50 + bart_health)
            sfx(13)
        end

        --- STATE STUFF ---
        prev_tile = current_tile
        state = next_state
        -------------------
    end
end

function _draw()
    cls()

    if screen_state == "menu" then
        map(16,0)

        print("Press 🅾️ to START", 50, 50, 7)
    elseif screen_state == "win" then
        print("YOU WIN", 50, 50, 7)
        print("Press 🅾️ to return to the MENU", 50, 60, 7)
    elseif screen_state == "game" then
        -- draw current map
        map()

        if show_flashing then
            draw_cells(tile_list[current_tile], 3)
        end

        if show_safe then
            draw_cells(tile_list[current_tile], 11)
        end

        spr(active_player_sprite, pos_x, pos_y)

        if maggie_gave_you_a_gun then
            spr(26, pos_x+8, pos_y)
        end

        -- draw particles
        draw_particles()

        for h in all(evil_homers) do
            h:draw()
        end

        for b in all(bullets) do
            b:draw()
        end

        ---------------------- MARGE HAIR -----------------------
        hair_count = ceil(bart_health / 10)
        for i = 2, hair_count do
            spr(39, 120, 120 - i*8)
        end

        if bart_health ~= 0 then
            spr(55, 120, 112 - hair_count*8)
            spr(23, 120, 112)
        end
        ---------------------------------------------------------

        if maggie_is_on_screen then
            spr(25, maggie_pos.x, maggie_pos.y)
        end

        if lisa_is_on_screen then
            spr(41, lisa_pos.x, lisa_pos.y)
        end

        draw_fade()
    end
end

function level_up()
    if current_tile_list == # tile_lists then
        screen_state = "win"
        reset_game()
    else
        current_tile = 1
        current_tile_list += 1
        game_speed += 1
    end    
end

function draw_cells(cell_array, colour)
    for cell in all(cell_array) do
        draw_cell(cell, colour)
    end
end

function draw_cell(cell_num, colour)
    -- cell_num starts at 0
    cell_x_pos, cell_y_pos = get_cell_pos(cell_num)

    x_end = cell_x_pos + 22
    y_end = cell_y_pos + 22

    rectfill(cell_x_pos, cell_y_pos, x_end, y_end, colour)
end

function get_cell_pos(cell_num)
    x_coord = cell_num % 5
    y_coord = cell_num \ 5

    x_start = x_coord * 24 + 1
    y_start = y_coord * 24 + 1

    return x_start, y_start
end

function draw_fade()
    if fade <= 0 then return end

    for y=0,127 do
        for x=0,127 do
            if ((x+y*2)&15) < fade then
                pset(x,y,0)
            end
        end
    end
end

function check_safety(x, y, size)
    for _, val in pairs(tile_list[current_tile]) do
        cell_x_pos, cell_y_pos = get_cell_pos(val)

        if check_collision(x, y, size,  cell_x_pos, cell_y_pos, 22) then
            return true
        end
    end
    return false
end

function homer_hit_bart(h)
    local dx = pos_x - h.x
    local dy = pos_y - h.y

    return dx*dx + dy*dy < 36 -- radius of 6 pixels
end

function bullet_hit_homer(h, b)
    local dx = b.x - h.x
    local dy = b.y - h.y

    return dx*dx + dy*dy < 18
end

function collide_with_maggie()
    local dx = pos_x - maggie_pos.x
    local dy = pos_y - maggie_pos.y

    return dx*dx + dy*dy < 36
end

function collide_with_lisa()
    local dx = pos_x - lisa_pos.x
    local dy = pos_y - lisa_pos.y

    return dx*dx + dy*dy < 36
end

function get_closest_homer()
    min_dist = 300
    min_homer = nil

    for h in all(evil_homers) do
        local dx = pos_x - h.x
        local dy = pos_y - h.y
        local dist = sqrt(dx*dx + dy*dy)

        if dist < min_dist then
            min_dist = dist
            min_homer = h
        end
    end

    return min_homer
end

function shoot()
    if next(evil_homers) ~= nil then
        closest_homer = get_closest_homer()
        target_x = closest_homer.x
        target_y = closest_homer.y
    else
        target_x = pos_x + 100
        target_y = pos_y
    end

    sfx(11)
    maggie_gave_you_a_gun = false
    add(bullets, make_bullet(target_x, target_y))
end

function check_collision(x1, y1, s1, x2, y2, s2)
    return x1 < x2 + s2 and
           x2 < x1 + s1 and
           y1 < y2 + s2 and
           y2 < y1 + s1
end

function spawn_bart_death_particles()
    -- add bone particles
    for _ = 0, 30 do
        add(particles, {pos_x, pos_y, 3-rnd(6), 3-rnd(6), 4, 50})
    end
    -- add blood particles
    for _ = 0, 30 do
        add(particles, {pos_x, pos_y, 3-rnd(6), 3-rnd(6), 5, 50})
    end
    -- add skin falling off face
    add(particles, {pos_x, pos_y, 0, 1, 6, 50})

    death_particle_life = 50
end

function spawn_homer_death_particles(homer_x, homer_y)
    for _ = 0, 5 do
        add(particles, {homer_x, homer_y, 2-rnd(4), 2-rnd(4), 35, 10})
    end
    -- add blood particles
    for _ = 0, 5 do
        add(particles, {homer_x, homer_y, 2-rnd(4), 2-rnd(4), 36, 10})
    end
end

function add_munching_particle()
    add(particles, {pos_x, pos_y, 2-rnd(4), 2-rnd(4), 5, 10})
end

function move_particles()
    for particle in all(particles) do
        move_particle(particle)
        particle[6] = particle[6] - 1
    end

    for particle in all(particles) do
        if particle[6] <= 0 then
            del(particles, particle)
        end
    end
end

function move_particle(particle)
    particle[1] = particle[1] + particle[3]
    particle[2] = particle[2] + particle[4]
end

function draw_particles()
    for particle in all(particles) do
        spr(particle[5], particle[1], particle[2])
    end
end

function kill_bart()
    music(1)
    spawn_bart_death_particles()
end

