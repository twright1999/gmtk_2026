pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
    pos_x = 64
    pos_y = 64
end
-- ⬆️⬇️➡️
function _update()
    if btn(➡️) then pos_x += 3 end
    if btn(⬅️) then pos_x -= 3 end
    if btn(⬇️) then pos_y += 3 end
    if btn(⬆️) then pos_y -= 3 end
end

function _draw()
    cls()

    -- draw current map
    draw_cells({1, 3, 17, 24}, 8)
    map()

    -- draw sprites
    spr(1, pos_x, pos_y)
end

function draw_cells(cell_array, colour)
    for cell in all(cell_array) do
        draw_cell(cell, colour)
    end
end

function draw_cell(cell_num, colour)
    -- cell_num starts at 0
    x_coord = cell_num % 5
    y_coord = cell_num \ 5

    x_start = x_coord * 24 + 1
    x_end = x_start + 22
    y_start = y_coord * 24 + 1
    y_end = y_start + 22

    rectfill(x_start, y_start, x_end, y_end, colour)
end

