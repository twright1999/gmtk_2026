pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
    pos_x = 64
    pos_y = 64
end
-- ⬆️⬇️➡️
function _update()
    if btn(➡️) then pos_x += 3 end
    if btn(⬅️) then pos_x -= 3 end
    if btn(⬇️) then pos_y += 3 end
    if btn(⬆️) then pos_y -= 3 end
end

function _draw()
    cls()
    
    rectfill(0, 0, 23, 23, 3)
    
    map()

    spr(1, pos_x, pos_y)
end

