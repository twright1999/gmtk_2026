pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
    pos_x = 64
    pos_y = 64
end
-- ⬆️⬇️➡️
function _update()
    if btn(➡️) then pos_x += 1 end
    if btn(⬅️) then pos_x -= 1 end
    if btn(⬇️) then pos_y += 1 end
    if btn(⬆️) then pos_y -= 1 end
end

function _draw()
    cls()

    spr(1, pos_x, pos_y)
end

